---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  piece: CollectionEntry<'pieces'>['data'];
  priority?: boolean;
}

const { piece, priority = false } = Astro.props;
---

<div class="piece">
  <Image src={piece.image} alt={piece.alt} priority={priority} />
  <div class="caption" style={`background-color: ${piece.captionBackground}; color: ${piece.captionText};`}>
    <p class="title">{piece.title}</p>
    <p class="description">{piece.description}</p>
  </div>
</div>

<style>
  /* S6.3 — image and its own caption are flush; the gap belongs to the
     stack container (global.css), never here. */
  .piece {
    display: block;
  }

  .piece :global(img) {
    display: block;
    /* S6.6 — "nothing is cropped." Astro's image.objectFit default is
       "cover"; with layout: 'full-width' it's currently inert because the
       box's aspect-ratio always matches the image's own, but that's a
       coincidence of this configuration, not a guarantee. Pin it so
       cropping can't silently reappear if that ever changes. */
    object-fit: contain;
  }

  .caption {
    padding-block-start: clamp(12px, 3vw, 24px);
    padding-inline: clamp(12px, 3vw, 24px);
    /* S6.14 redesign — fixed 30px, not the fluid clamp above: this is the
       one thing separating this caption from the next piece's image, now
       that the stack's own gap is gone. */
    padding-block-end: 30px;
  }

  /* S9.4/S6.4 redesign — own typeface/weight/size, not bold. */
  .title {
    font-family: var(--font-body), sans-serif;
    font-weight: 400;
    font-size: 20px;
    margin: 0 0 0.5em;
  }

  .description {
    margin: 0;
  }
</style>
