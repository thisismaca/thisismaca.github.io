---
import ContactInfo from './ContactInfo.astro';

interface Props {
  copyright?: boolean;
}

const { copyright = false } = Astro.props;
---

<footer>
  {copyright ? <p class="copyright">© Maca Sepúlveda 2026</p> : <ContactInfo />}
</footer>

<style>
  /* S5.6 — no shadow, no border, on any state. Deliberately absent below:
     not an oversight, the recessive white-on-white treatment is the point. */
  footer {
    background: var(--color-white);
  }

  /* S5.8 redesign — fixed height at 768px+, contents centred inside;
     unchanged (auto, from padding/content) below that. */
  @media (min-width: 768px) {
    footer {
      height: 80px;
      display: flex;
      align-items: center;
    }
  }

  /* S8.4 — the /contact-only state. */
  .copyright {
    width: 100%;
    margin: 0;
    padding-block: clamp(8px, 2vw, 16px);
    text-align: center;
    font-size: 10px;
    color: var(--color-body-text);
  }
</style>
