---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** S8.4/S8.5 — true only on /contact. */
  footerCopyright?: boolean;
  /** S6.13/S7.8/S8.7 — narrows content to 40% of the viewport, centred, at 768px+. All three pages set this. */
  narrowContent?: boolean;
  /** S7.8/S8.7 — additionally centres content vertically at 768px+. About/Contact only, not Home. */
  centerContent?: boolean;
  /** Per-page meta description. Omitted entirely (not just empty) when a page has none. */
  description?: string;
  /** Excludes this page from search indexing. About/Contact only — Home is
      the page whose content (piece names/places) is meant to be found. */
  noindex?: boolean;
}

const {
  footerCopyright = false,
  narrowContent = false,
  centerContent = false,
  description,
  noindex = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Per-page titles are still SPEC.md open question 5 — unresolved,
         not this feature's job to decide. One fixed title until then. -->
    <title>thisismaca.com</title>
    <!-- S9.3 — registering the fonts here is what actually emits the
         @font-face rules and metric-matched fallback; declaring `fonts:`
         in astro.config.mjs alone only makes them available, it doesn't
         use them on a page. Preloaded since both are used above the fold
         on every route. -->
    <Font cssVariable="--font-menu" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body>
    <!-- S4.11 redesign — the shadow is now universal; Header takes no prop. -->
    <Header />
    <main class:list={[{ narrow: narrowContent, center: centerContent }]}>
      <slot />
    </main>
    <Footer copyright={footerCopyright} />
  </body>
</html>

<style>
  /* S8.8 — one mechanism for every page, not a Contact-only special case:
     footer is the last flex child of a min-height:100vh column, so it
     sits at the bottom on short pages and simply follows content once
     content (like Home's stack) grows past one screen. */
  body {
    display: flex;
    flex-direction: column;
    /* 100vh is the largest possible mobile viewport (browser chrome
       collapsed), so on load — chrome still visible — it overshoots the
       real visible area and pushes the footer below the fold until the
       page is scrolled. dvh tracks the actual visible viewport instead. */
    min-height: 100vh;
    min-height: 100dvh;
  }

  main {
    flex: 1 0 auto;
  }

  /* S6.13/S7.8/S8.7 — 768px+ only; confirmed necessary at this exact
     line by the header-nav math in specs/005-visual-redesign/research.md,
     reused here for consistency (S11.1: one breakpoint, not a second). */
  @media (min-width: 768px) {
    main.narrow {
      width: 40%;
      margin-inline: auto;
    }

    main.center {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>
