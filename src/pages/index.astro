---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Piece from '../components/Piece.astro';

const pieces = (await getCollection('pieces')).sort((a, b) => a.data.order - b.data.order);
---

<Base narrowContent={true}>
  <div class="stack">
    {pieces.map((piece) => (
      <Piece piece={piece.data} priority={piece.data.order === 1} />
    ))}
  </div>
</Base>
